// ============================================================
// mediCitas API - Esquema de base de datos
// Conversión del modelo relacional MySQL Workbench
// (modelo_relacional.mwb) a PostgreSQL vía Prisma.
//
// Decisiones de diseño (ver openspec design.md):
//   - Claves primarias UUID
//   - Enums para estados y tipo de sangre
//   - Soft delete (deleted_at) en todas las tablas
//   - Auditoría created_at / updated_at en todas las tablas
//   - PKs compuestas en tablas de unión
//   - diasAtencion como bitmask entero + columna version
//     para bloqueo optimista en schedules
// ============================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==================== ENUMS ====================

/// Estado de cuentas de usuario
enum UserStatus {
  ACTIVE
  INACTIVE
}

/// Estado de roles
enum RoleStatus {
  ACTIVE
  INACTIVE
}

/// Estado de especialidades médicas
enum SpecialtyStatus {
  ACTIVE
  INACTIVE
}

/// Estado de doctores
enum DoctorStatus {
  ACTIVE
  INACTIVE
}

/// Estado de empleados
enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

/// Estado de cargos (puestos de trabajo)
enum CargoStatus {
  ACTIVE
  INACTIVE
}

/// Estado de horarios de atención
enum ScheduleStatus {
  ACTIVE
  INACTIVE
}

/// Ciclo de vida de una cita médica
enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

/// Tipos de sangre estándar
enum BloodType {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
}

// ==================== UBICACIONES ====================

model Country {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @unique @db.VarChar(100)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @default(now()) @updatedAt @map("updated_at")
  deletedAt   DateTime?    @map("deleted_at")

  departments Department[]
  persons     Person[]

  @@map("countries")
}

model Department {
  id        String     @id @default(uuid()) @db.Uuid
  name      String     @db.VarChar(100)
  countryId String     @map("country_id") @db.Uuid
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @default(now()) @updatedAt @map("updated_at")
  deletedAt DateTime?  @map("deleted_at")

  country       Country       @relation(fields: [countryId], references: [id])
  municipalities Municipality[]
  persons       Person[]

  @@unique([name, countryId])
  @@index([countryId])
  @@map("departments")
}

model Municipality {
  id           String    @id @default(uuid()) @db.Uuid
  name         String    @db.VarChar(100)
  departmentId String    @map("department_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  department Department @relation(fields: [departmentId], references: [id])
  persons    Person[]

  @@unique([name, departmentId])
  @@index([departmentId])
  @@map("municipalities")
}

// ==================== PERSONAS Y USUARIOS ====================

model Person {
  id             String   @id @default(uuid()) @db.Uuid
  firstName      String   @map("first_name") @db.VarChar(50)
  middleName     String?  @map("middle_name") @db.VarChar(50)
  lastName       String   @map("last_name") @db.VarChar(50)
  secondLastName String?  @map("second_last_name") @db.VarChar(50)
  birthDate      DateTime @map("birth_date") @db.Date
  dni            String   @unique @db.VarChar(20)
  gender         String   @db.VarChar(20)
  address        String?  @db.VarChar(255)
  departmentId   String   @map("department_id") @db.Uuid
  municipalityId String   @map("municipality_id") @db.Uuid
  countryId      String   @map("country_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  department   Department   @relation(fields: [departmentId], references: [id])
  municipality Municipality @relation(fields: [municipalityId], references: [id])
  country      Country      @relation(fields: [countryId], references: [id])
  user         User?
  phones       Phone[]

  @@index([departmentId])
  @@index([municipalityId])
  @@index([countryId])
  @@map("persons")
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  personId     String     @unique @map("person_id") @db.Uuid
  email        String     @unique @db.VarChar(150)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at")
  deletedAt    DateTime?  @map("deleted_at")

  person   Person       @relation(fields: [personId], references: [id])
  employee Employee?
  patient  Patient?
  roles    UserRole[]
  sessions RefreshToken[]
  resetTokens PasswordResetToken[]

  @@index([status])
  @@map("users")
}

model Role {
  id          String     @id @default(uuid()) @db.Uuid
  name        String     @unique @db.VarChar(50)
  description String?    @db.VarChar(255)
  status      RoleStatus @default(ACTIVE)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @default(now()) @updatedAt @map("updated_at")
  deletedAt DateTime?  @map("deleted_at")

  users UserRole[]

  @@map("roles")
}

/// Unión Usuario-Rol (tabla UsuarioRol del modelo original)
model UserRole {
  userId    String     @map("user_id") @db.Uuid
  roleId    String     @map("role_id") @db.Uuid
  status    RoleStatus @default(ACTIVE)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @default(now()) @updatedAt @map("updated_at")
  deletedAt DateTime?  @map("deleted_at")

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

// ==================== EMPLEADOS Y CARGOS ====================

model Employee {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @unique @map("user_id") @db.Uuid
  status    EmployeeStatus @default(ACTIVE)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @default(now()) @updatedAt @map("updated_at")
  deletedAt DateTime?      @map("deleted_at")

  user        User            @relation(fields: [userId], references: [id])
  doctor      Doctor?
  cargoAssign EmployeeCargo[]

  @@map("employees")
}

model Cargo {
  id        String      @id @default(uuid()) @db.Uuid
  name      String      @unique @db.VarChar(80)
  status    CargoStatus @default(ACTIVE)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @default(now()) @updatedAt @map("updated_at")
  deletedAt DateTime?   @map("deleted_at")

  employees EmployeeCargo[]

  @@map("cargos")
}

/// Unión Empleado-Cargo con fecha de asignación (EmpleadoCargo original).
/// Historial preservado: cada cambio de cargo crea nueva fila.
model EmployeeCargo {
  employeeId String   @map("employee_id") @db.Uuid
  cargoId    String   @map("cargo_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  employee Employee @relation(fields: [employeeId], references: [id])
  cargo    Cargo    @relation(fields: [cargoId], references: [id])

  @@id([employeeId, cargoId, assignedAt])
  @@index([cargoId])
  @@map("employee_cargos")
}

// ==================== DOCTORES Y ESPECIALIDADES ====================

model Specialty {
  id        String          @id @default(uuid()) @db.Uuid
  name      String          @unique @db.VarChar(100)
  status    SpecialtyStatus @default(ACTIVE)
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @default(now()) @updatedAt @map("updated_at")
  deletedAt DateTime?       @map("deleted_at")

  doctors   DoctorSpecialty[]
  schedules Schedule[]

  @@map("specialties")
}

model Doctor {
  id         String       @id @default(uuid()) @db.Uuid
  employeeId String       @unique @map("employee_id") @db.Uuid
  status     DoctorStatus @default(ACTIVE)
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @default(now()) @updatedAt @map("updated_at")
  deletedAt  DateTime?    @map("deleted_at")

  employee   Employee          @relation(fields: [employeeId], references: [id])
  specialties DoctorSpecialty[]
  schedules  Schedule[]

  @@map("doctors")
}

/// Unión Doctor-Especialidad (DoctorEspecialidad original)
model DoctorSpecialty {
  doctorId    String          @map("doctor_id") @db.Uuid
  specialtyId String          @map("specialty_id") @db.Uuid
  status      SpecialtyStatus @default(ACTIVE)
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @default(now()) @updatedAt @map("updated_at")
  deletedAt   DateTime?       @map("deleted_at")

  doctor    Doctor    @relation(fields: [doctorId], references: [id])
  specialty Specialty @relation(fields: [specialtyId], references: [id])

  @@id([doctorId, specialtyId])
  @@index([specialtyId])
  @@map("doctor_specialties")
}

// ==================== HORARIOS ====================

/// HorarioAtencion original.
/// - daysBitmask: bitmask de días de atención (bit 0 = lunes ... bit 6 = domingo)
/// - version: bloqueo optimista para reserva de citas
model Schedule {
  id           String         @id @default(uuid()) @db.Uuid
  doctorId     String         @map("doctor_id") @db.Uuid
  specialtyId  String         @map("specialty_id") @db.Uuid
  daysBitmask  Int            @map("days_bitmask")
  startTime    String         @map("start_time") @db.VarChar(5)
  endTime      String         @map("end_time") @db.VarChar(5)
  slotCapacity Int            @map("slot_capacity")
  observation  String?        @db.VarChar(255)
  timezone     String         @default("America/Tegucigalpa") @db.VarChar(50)
  version      Int            @default(1)
  status       ScheduleStatus @default(ACTIVE)
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @default(now()) @updatedAt @map("updated_at")
  deletedAt    DateTime?      @map("deleted_at")

  doctor       Doctor       @relation(fields: [doctorId], references: [id])
  specialty    Specialty    @relation(fields: [specialtyId], references: [id])
  appointments Appointment[]

  @@index([doctorId])
  @@index([specialtyId])
  @@map("schedules")
}

// ==================== CONTACTOS ====================

model Extension {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique @db.VarChar(50)
  status    RoleStatus @default(ACTIVE)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  phones Phone[]

  @@map("extensions")
}

model Phone {
  id          String    @id @default(uuid()) @db.Uuid
  number      String    @db.VarChar(20)
  personId    String    @map("person_id") @db.Uuid
  extensionId String    @map("extension_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  person    Person    @relation(fields: [personId], references: [id])
  extension Extension @relation(fields: [extensionId], references: [id])

  @@unique([number, personId])
  @@index([personId])
  @@map("phones")
}

// ==================== SESIONES Y RESTABLECIMIENTO ====================

/// Refresh tokens opacos almacenados hasheados (SHA-256).
/// family_id agrupa la cadena de rotación para detectar reuso:
/// si un token ya revocado se presenta de nuevo, se revoca toda la familia.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  familyId  String    @map("family_id") @db.Uuid
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

/// Tokens de un solo uso para restablecimiento de contraseña (TTL corto).
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ==================== PACIENTES Y CITAS ====================

model Patient {
  id                     String    @id @default(uuid()) @db.Uuid
  userId                 String    @unique @map("user_id") @db.Uuid
  bloodType              BloodType @map("blood_type")
  emergencyContactName   String?   @map("emergency_contact_name") @db.VarChar(150)
  emergencyContactNumber String?   @map("emergency_contact_number") @db.VarChar(20)
  allergies              String?   @db.VarChar(500)
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt              DateTime? @map("deleted_at")

  user         User          @relation(fields: [userId], references: [id])
  appointments Appointment[]

  @@map("patients")
}

/// Cita original.
/// Constraint unique (scheduleId, date, position) para prevenir
/// posiciones duplicadas por horario y fecha (concurrencia).
model Appointment {
  id          String            @id @default(uuid()) @db.Uuid
  patientId   String            @map("patient_id") @db.Uuid
  scheduleId  String            @map("schedule_id") @db.Uuid
  date        DateTime          @db.Date
  position    Int?
  observation String?           @db.VarChar(500)
  status      AppointmentStatus @default(PENDING)
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @default(now()) @updatedAt @map("updated_at")
  deletedAt   DateTime?         @map("deleted_at")

  patient  Patient  @relation(fields: [patientId], references: [id])
  schedule Schedule @relation(fields: [scheduleId], references: [id])

  @@unique([scheduleId, date, position])
  @@index([patientId])
  @@index([scheduleId, date])
  @@map("appointments")
}
